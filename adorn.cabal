cabal-version: 3.4
name: adorn
version: 0.0.1

executable adorn
    main-is: Main.hs
    hs-source-dirs: src

    autogen-modules: Paths_adorn

    other-modules:
      Paths_adorn
      Cleanup
      Script
      Action
      BuildError
      Executor
      Mapping
      Plan
      Task
      Html
      Index
      Query
      Layout
      Typst

    build-depends:
      base,
      aeson,
      containers,
      bytestring,
      filepath,
      extra,
      array,
      path,
      directory,
      text,
      time,
      megaparsec,
      parser-combinators,
      unordered-containers,
      cmdargs,
      regex-tdfa,
      transformers,
      mtl,
      mustache,
      tagsoup

    default-language: Haskell2010
    ghc-options: -Wall
