cabal-version: 3.4
name: adorn
version: 0.0.1

executable adorn
    main-is: Main.hs
    hs-source-dirs: src

    autogen-modules: Paths_adorn

    other-modules:
      Paths_adorn
      Action
      Executor
      Mapping
      Task

    build-depends:
      base,
      extra,
      array,
      path,
      directory,
      text,
      megaparsec,
      parser-combinators,
      unordered-containers,
      cmdargs,
      regex-tdfa,
      transformers,
      mtl,
      template

    default-language: Haskell2010
