cabal-version: 3.4
name: adorn
version: 0.0.1

executable adorn
    main-is: Main.hs
    hs-source-dirs: src

    autogen-modules: Paths_adorn

    other-modules:
      Paths_adorn
      Mapping

    build-depends:
      base,
      extra,
      directory,
      text,
      megaparsec,
      parser-combinators,
      cmdargs,
      regex-tdfa

    default-language: Haskell2010
